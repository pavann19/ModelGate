{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "failurePolicy", "timeoutSeconds", "image", "tls", "metrics", "registryPolicySecret", "networkPolicy"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 2},
    "failurePolicy": {"type": "string", "enum": ["Fail"]},
    "timeoutSeconds": {"type": "integer", "minimum": 13, "maximum": 30},
    "registryPolicySecret": {"type": "string", "minLength": 1},
    "tls": {
      "type": "object", "additionalProperties": false, "required": ["secretName", "caBundle"],
      "properties": {"secretName": {"type": "string", "minLength": 1}, "caBundle": {"type": "string"}}
    },
    "metrics": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "serviceMonitor"],
      "properties": {
        "enabled": {"type": "boolean"},
        "serviceMonitor": {
          "type": "object", "additionalProperties": false, "required": ["enabled", "interval"],
          "properties": {"enabled": {"type": "boolean"}, "interval": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$"}}
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "allowMutableTags", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9./:_-]*$"},
        "tag": {"type": "string", "pattern": "^([a-zA-Z0-9_][a-zA-Z0-9_.-]{0,127})?$"},
        "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
        "allowMutableTags": {"type": "boolean"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "apiServerCIDRs", "apiServerPorts", "registryEndpoints", "metricsNamespaceSelector"],
      "properties": {
        "enabled": {"type": "boolean"},
        "apiServerCIDRs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/cidr"}},
        "apiServerPorts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/port"}},
        "registryEndpoints": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["cidr", "port"],
            "properties": {"cidr": {"$ref": "#/definitions/cidr"}, "port": {"$ref": "#/definitions/port"}}
          }
        },
        "metricsNamespaceSelector": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    }
  },
  "definitions": {
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "cidr": {"type": "string", "minLength": 3, "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$", "not": {"pattern": "/0$"}}
  }
}
